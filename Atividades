notas_alunos = [7.5, 8.0, 6.5, 9.0, 5.5]
notas_alunos2 = [7.5, 8.0, 6.5, 9.0, 5.5, 10.0]

def calcular_media(lista_de_numeros):
    soma = sum(lista_de_numeros)
    quantidade = len(lista_de_numeros)
    if quantidade > 0:
        media = soma / quantidade
    else:
        media = 0
    return media

print(f"A média dos números é: {calcular_media(notas_alunos)}")
print(f"A média dos números é: {calcular_media(notas_alunos2)}")
